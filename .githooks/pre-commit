#!/bin/sh

# Get the current branch name
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# Check if the current branch is in the protected list
case "$BRANCH_NAME" in
  main|dev|develop|master)
    echo "ERROR: Direct commits to the '${BRANCH_NAME}' branch are not allowed."
    echo "Please create a new feature branch and commit there."
    exit 1 # Exit with a non-zero status to block the commit
    ;;
esac

exit 0 # Exit with zero to allow the commit
